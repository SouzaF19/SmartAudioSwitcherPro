<Window x:Class="SmartAudioSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartAudioSwitcher.App"
        xmlns:vm="clr-namespace:SmartAudioSwitcher.App.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:SmartAudioSwitcher.UI.Controls;assembly=SmartAudioSwitcher.UI"
        mc:Ignorable="d"
        Title="SmartAudioSwitcher" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">
    
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TypeIcon}" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FriendlyName}" FontWeight="Medium" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle" Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                 Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" ToolTip="Default Device" />
                        <materialDesign:PackIcon Kind="MessageOutline" Foreground="{DynamicResource SecondaryHueMidBrush}" 
                                 Visibility="{Binding IsCommunicationsDefault, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" ToolTip="Communications Device" />
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="Green" 
                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" ToolTip="Connected" />
                        <materialDesign:PackIcon Kind="CloseCircleOutline" Foreground="Red" 
                                 Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}" ToolTip="Disconnected" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RoutingViewModel}">
            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ArrowRightBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding ProcessName}" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Speaker" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding DeviceName}" VerticalAlignment="Center" />
                        <materialDesign:PackIcon Kind="AlertOutline" Foreground="Orange" VerticalAlignment="Center" Margin="8,0,0,0" 
                                 Visibility="{Binding IsFallback, Converter={StaticResource BoolToVis}}" ToolTip="Fallback device" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProfileName}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TimeAgo}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SpeakerWireless" Width="28" Height="28" Foreground="White" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="SmartAudioSwitcher" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Intelligent Audio Device Switcher" FontSize="11" Foreground="#BBFFFFFF" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle" Foreground="LightGreen" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignToolButton}" ToolTip="Settings" Command="{Binding OpenSettingsCommand}">
                        <materialDesign:PackIcon Kind="Cog" Foreground="White" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" ToolTip="Minimize to Tray" Command="{Binding MinimizeToTrayCommand}">
                        <materialDesign:PackIcon Kind="Minimize" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="20">
                    <TextBlock Text="SonicFlow" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,20"/>
                    <Button x:Name="btnAddApp" Content="Add App Node" Margin="0,5" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                    <Button x:Name="btnAddDevice" Content="Add Device Node" Margin="0,5" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                    <Separator Margin="0,20"/>
                    <TextBlock Text="Actions" FontWeight="Medium" Margin="0,0,0,10"/>
                    <Button x:Name="btnApplyRoutes" Content="Apply Routes" Margin="0,5" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"/>
                    <Button x:Name="btnRefreshNodes" Content="Refresh Nodes" Margin="0,5" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="Profile Actions" FontWeight="Medium" Margin="0,0,0,10"/>
                    <Button x:Name="btnSaveProfile" Content="Save Profile" Margin="0,5" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"/>
                    <Button x:Name="btnLoadProfile" Content="Load Profile" Margin="0,5" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch"/>
                    <Button x:Name="btnClearCanvas" Content="Clear Canvas" Margin="0,5" Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" Foreground="Red"/>
                    <Separator Margin="0,20"/>
                    <TextBlock Text="Saved Profiles" FontWeight="Medium" Margin="0,0,0,10"/>
                    <ListBox x:Name="ProfileList" MouseDoubleClick="ProfileList_MouseDoubleClick"/>
                </StackPanel>
            </Border>

            <!-- Routing Canvas Area -->
            <controls:RoutingCanvas x:Name="MainCanvas" Grid.Column="1" Background="#1E1E1E">
                <!-- Nodes will be added dynamically here -->
            </controls:RoutingCanvas>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="SmartAudioSwitcher Pro" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>